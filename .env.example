# MAUSAM Progressive Web App - Environment Variables Configuration

# OpenAI API Key (Optional: for live GPT-4o Smart Briefs and Ask MAUSAM assistant. App falls back gracefully to smart offline NLP engine if omitted)
VITE_OPENAI_API_KEY=

# Supabase Credentials (Optional: for cloud authentication and Postgres database sync. App uses offline-first persistent localStorage if omitted)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map API Key (Optional: for TomTom traffic layers)
VITE_TOMTOM_API_KEY=
